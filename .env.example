# HomePlace configuration.
#
# Copy to .env and fill in what applies to your machine:
#
#   cp .env.example .env
#
# .env is in .gitignore and must stay there: every address, token and password
# of your server ends up in this file, and this repository is public.
#
# Everything below is optional. With an empty .env HomePlace still starts, shows
# the setup wizard, and lets you add links by hand — each integration only adds
# what it can see.

# ─────────────────────────────── Basics ──────────────────────────────────

# Public address of the panel. Used to build OAuth redirects and to decide
# whether cookies get the Secure flag.
APP_URL=http://localhost:3200

# Published port on the host.
APP_PORT=3200

# Signing key for session cookies. Generate one:
#   openssl rand -hex 32
# If left empty, HomePlace generates a key and stores it in the database — fine
# for a first run, but set it here so sessions survive a rebuilt volume.
AUTH_SECRET=

# Where the SQLite database lives on the host. Keep it on local disk, not on a
# network share: SQLite does many small writes and NFS is the classic way to
# corrupt one.
HOST_DATA_DIR=./data

# Who owns that directory. The container adjusts it at start, so a bind mount
# works without chowning anything by hand. Use your own ids: `id -u` / `id -g`.
PUID=1000
PGID=1000

# en | ru — the language new accounts start with.
DEFAULT_LOCALE=en

# ─────────────────────────────── Docker ──────────────────────────────────

# Address of the Docker HTTP API. The bundled compose file runs
# docker-socket-proxy for this; leave the default unless you have your own.
#
# Do not point this at /var/run/docker.sock. Direct socket access is equivalent
# to root on the host, and a dashboard should not be holding that.
DOCKER_API_URL=http://docker-socket-proxy:2375

# Label shown for that endpoint in the interface.
DOCKER_HOST_LABEL=Server

# Several machines instead of one — JSON, overrides DOCKER_API_URL:
# DOCKER_HOSTS=[{"key":"main","label":"Server","url":"http://docker-socket-proxy:2375"},{"key":"nas","label":"NAS","url":"http://10.0.0.5:2375"}]
DOCKER_HOSTS=

# false makes the installation strictly read-only: no start, stop or restart,
# whatever the interface offers and whoever signs in.
ALLOW_CONTAINER_CONTROL=true

# ────────────────────────── Metrics: Prometheus ──────────────────────────

# Prometheus with node_exporter (hardware) and cAdvisor (containers). This is
# what fills the charts, disk usage and temperatures. Without it the dashboard
# still shows availability, gathered by HomePlace itself.
PROMETHEUS_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# ─────────────────────────────── Proxmox ─────────────────────────────────

# Read-only view of the hypervisor: guests, physical disks, SMART, storages.
# Create an API token in Datacenter → Permissions → API Tokens and give it
# PVEAuditor on /.
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Home installs use the self-signed certificate the installer generated; set to
# true only if you gave Proxmox a certificate this container can verify.
PROXMOX_VERIFY_TLS=false

# ──────────────────────── FriendPlace SSO (optional) ─────────────────────
#
# Only relevant if you also run FriendPlace, which can act as an OAuth 2.0
# provider. Leave empty and the button never appears — local accounts are the
# normal way in.
#
# Register HomePlace there with the redirect URI:
#   <APP_URL>/api/auth/callback/friendplace
FRIENDPLACE_URL=
FRIENDPLACE_CLIENT_ID=
FRIENDPLACE_CLIENT_SECRET=
# true = only FriendPlace administrators may enter. If that FriendPlace does not
# report administrator status at all, everyone is refused rather than let in.
FRIENDPLACE_ADMINS_ONLY=true
# Role given to a newly linked account: admin | viewer
FRIENDPLACE_DEFAULT_ROLE=admin

# ────────────────────────────── Behaviour ────────────────────────────────

# The built-in availability prober.
MONITOR_ENABLED=true
# Floor for per-tile check intervals, in seconds — protects a service from a
# typo in the interval field.
MIN_CHECK_INTERVAL=15
# How long the rolling uptime window is kept.
UPTIME_RETENTION_DAYS=30
# How long a session lasts.
SESSION_DAYS=30
# Empty = decided from APP_URL. Set to false if you serve the panel over plain
# HTTP, otherwise the browser will drop the session cookie.
SECURE_COOKIES=
